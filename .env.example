# --- Server ---
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# --- Database (MongoDB Atlas free tier recommended — Hostinger shared hosting cannot run MongoDB itself) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pngone?retryWrites=true&w=majority

# --- Sessions ---
SESSION_SECRET=change-this-to-a-long-random-string

# --- Default admin account, created by `npm run seed` ---
ADMIN_EMAIL=admin@pngonefashion.com
ADMIN_PASSWORD=change-this-password

# --- VNPay (sandbox values from https://sandbox.vnpayment.vn) ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/checkout/vnpay-return

# --- MoMo (sandbox values from https://developers.momo.vn) ---
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:3000/checkout/momo-return
MOMO_NOTIFY_URL=http://localhost:3000/checkout/momo-notify

# --- Bank transfer QR (VietQR — https://vietqr.io, no API key needed) ---
BANK_BIN=970436
BANK_ACCOUNT_NO=0421003727501
BANK_ACCOUNT_NAME=LE CONG BINH NGUYEN
BANK_NAME=Vietcombank
