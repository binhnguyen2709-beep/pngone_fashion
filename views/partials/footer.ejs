<footer class="site-footer" id="contact">
  <div class="footer-grid">
    <div>
      <img src="/images/logo-full.png" alt="PNG ONE FASHION — Professional Noble Global" class="footer-logo" />
      <p class="footer-tagline"><%= t('nav.tagline') %></p>
      <p class="footer-tagline" style="margin-top: 0.3rem; font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--brass-soft);"><%= t('footer.parent') %></p>
    </div>
    <div>
      <div class="footer-heading"><%= t('nav.collection') %></div>
      <ul class="footer-links">
        <li><a href="/collection/ao-khoac"><%= locale === 'en' ? 'Outerwear' : 'Áo khoác' %></a></li>
        <li><a href="/collection/dam"><%= locale === 'en' ? 'Dresses' : 'Đầm' %></a></li>
        <li><a href="/collection/ao-so-mi"><%= locale === 'en' ? 'Shirts & Tops' : 'Áo sơ mi & Áo' %></a></li>
        <li><a href="/collection/quan-vay"><%= locale === 'en' ? 'Trousers & Skirts' : 'Quần & Chân váy' %></a></li>
      </ul>
    </div>
    <div>
      <div class="footer-heading"><%= t('nav.contact') %></div>
      <ul class="footer-links">
        <li>hello@pngonefashion.com</li>
        <li>+84 (0) 000 000 000</li>
        <li><%= t('footer.address') %></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© <%= new Date().getFullYear() %> PNG ONE FASHION. <%= t('footer.rights') %></span>
    <a href="/admin/login">Admin</a>
  </div>
</footer>
