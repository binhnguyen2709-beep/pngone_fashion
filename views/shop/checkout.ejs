<section class="section">
  <div class="wrap">
    <h1 class="section-title"><%= t('checkout.title') %></h1>

    <% if (error) { %>
      <div class="form-error" style="margin-top: var(--space-3);"><%= error %></div>
    <% } %>

    <form action="/checkout/place-order" method="POST">
      <div class="checkout-grid" style="margin-top: var(--space-3);">
        <div>
          <h2 style="font-size: 1.3rem; margin-bottom: var(--space-2);"><%= t('checkout.shipping') %></h2>

          <div class="form-row-split">
            <div class="form-row">
              <label class="field-label"><%= t('checkout.fullName') %> *</label>
              <input type="text" name="fullName" required />
            </div>
            <div class="form-row">
              <label class="field-label"><%= t('checkout.phone') %> *</label>
              <input type="tel" name="phone" required />
            </div>
          </div>

          <div class="form-row">
            <label class="field-label"><%= t('checkout.email') %></label>
            <input type="email" name="email" />
          </div>

          <div class="form-row-split">
            <div class="form-row">
              <label class="field-label"><%= t('checkout.address') %> *</label>
              <input type="text" name="address" required />
            </div>
            <div class="form-row">
              <label class="field-label"><%= t('checkout.city') %> *</label>
              <input type="text" name="city" required />
            </div>
          </div>

          <div class="form-row">
            <label class="field-label"><%= t('checkout.note') %></label>
            <textarea name="note"></textarea>
          </div>

          <h2 style="font-size: 1.3rem; margin: var(--space-3) 0 var(--space-2);"><%= t('checkout.payment') %></h2>
          <div class="payment-options">
            <label class="payment-option">
              <input type="radio" name="paymentMethod" value="cod" checked />
              <%= t('checkout.payCod') %>
            </label>
            <label class="payment-option">
              <input type="radio" name="paymentMethod" value="vnpay" />
              <%= t('checkout.payVnpay') %>
            </label>
            <label class="payment-option">
              <input type="radio" name="paymentMethod" value="momo" />
              <%= t('checkout.payMomo') %>
            </label>
          </div>

          <button type="submit" class="btn btn-primary"><%= t('checkout.placeOrder') %></button>
        </div>

        <div class="checkout-summary-box">
          <h2 style="font-size: 1.1rem; margin-bottom: var(--space-2);"><%= t('checkout.orderSummary') %></h2>
          <% cart.forEach(function(item) { %>
            <div class="line-item">
              <span><%= item.name %> (<%= item.size %>) × <%= item.qty %></span>
              <span><%= (item.price * item.qty).toLocaleString('vi-VN') %> ₫</span>
            </div>
          <% }) %>
          <div class="cart-summary-row total">
            <span><%= t('cart.subtotal') %></span>
            <span><%= subtotal.toLocaleString('vi-VN') %> ₫</span>
          </div>
        </div>
      </div>
    </form>
  </div>
</section>
