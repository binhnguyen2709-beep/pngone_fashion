<section class="hero">
  <span class="hero-bleed-word" aria-hidden="true">PNG ONE</span>
  <div class="hero-grid">
    <div class="hero-copy">
      <span class="eyebrow eyebrow--light" data-reveal style="--reveal-i: 0;"><%= t('home.heroEyebrow') %></span>
      <h1 class="hero-title" data-reveal style="--reveal-i: 1;"><%= t('home.heroTitle') %></h1>
      <p class="hero-subtitle" data-reveal style="--reveal-i: 2;"><%= t('home.heroSubtitle') %></p>
      <a href="/collection" class="btn btn-primary" data-reveal style="--reveal-i: 3;"><%= t('home.heroCta') %></a>
    </div>
    <div class="hero-visual" data-reveal style="--reveal-i: 1;">
      <img src="/images/hero.jpg" alt="<%= t('home.heroImageAlt') %>" />
      <span class="hero-visual-label">SS26 · N°1</span>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <div>
        <span class="eyebrow"><%= t('home.featuredEyebrow') %></span>
        <h2 class="section-title"><%= t('home.featuredTitle') %></h2>
      </div>
      <a href="/collection" class="btn btn-outline"><%= t('home.viewAll') %></a>
    </div>
    <% if (lookbook.length) { %>
      <div class="product-grid">
        <% lookbook.forEach(function(item, i) { %>
          <div class="product-card" data-reveal style="--reveal-i: <%= i %>;">
            <%- include('../partials/swatch', { product: { images: [item.image], name: item.name, swatchTone: 'bone' } }) %>
            <div class="product-meta">
              <span class="name"><%= field(item.name) %></span>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state"><%= t('home.emptyFeatured') %></div>
    <% } %>
  </div>
</section>

<section class="section" id="philosophy" style="background: var(--bone);">
  <div class="wrap">
    <div class="story-grid">
      <div class="story-image" data-reveal>
        <img src="/images/story.jpg" alt="<%= t('home.storyImageAlt') %>" />
        <span class="story-image-label" aria-hidden="true"><%= t('home.storyImageLabel') %></span>
      </div>
      <div class="story-content">
        <div class="section-head" data-reveal style="margin-bottom: var(--space-3);">
          <div>
            <span class="eyebrow"><%= t('home.philosophyEyebrow') %></span>
            <h2 class="section-title"><%= t('home.philosophyTitle') %></h2>
          </div>
        </div>
        <div class="philosophy-list">
          <div class="philosophy-item" data-reveal>
            <h3><%= t('home.philosophy1Title') %></h3>
            <p><%= t('home.philosophy1Body') %></p>
          </div>
          <div class="philosophy-item" data-reveal>
            <h3><%= t('home.philosophy2Title') %></h3>
            <p><%= t('home.philosophy2Body') %></p>
          </div>
          <div class="philosophy-item" data-reveal>
            <h3><%= t('home.philosophy3Title') %></h3>
            <p><%= t('home.philosophy3Body') %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
