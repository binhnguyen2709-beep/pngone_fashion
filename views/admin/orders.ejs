<div class="admin-topbar">
  <h1>Đơn hàng</h1>
</div>

<div class="admin-panel">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Mã đơn</th>
        <th>Khách hàng</th>
        <th>SĐT</th>
        <th>Tổng tiền</th>
        <th>Trạng thái thanh toán</th>
        <th>Trạng thái đơn</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (!orders.length) { %>
        <tr><td colspan="7">Chưa có đơn hàng nào.</td></tr>
      <% } %>
      <% orders.forEach(function(o) { %>
        <tr>
          <td><%= o.orderCode %></td>
          <td><%= o.customer.fullName %><br /><span style="color: rgba(21,20,15,0.55); font-size: 0.8rem;"><%= o.customer.address %>, <%= o.customer.city %></span></td>
          <td><%= o.customer.phone %></td>
          <td><%= o.subtotal.toLocaleString('vi-VN') %> ₫ <br /><span style="font-size: 0.78rem; text-transform: uppercase; color: rgba(21,20,15,0.55);"><%= o.paymentMethod %></span></td>
          <td>
            <form action="/admin/orders/<%= o._id %>/status" method="POST">
              <select name="paymentStatus" class="status-select" onchange="this.form.submit()">
                <% ['pending','paid','failed'].forEach(function(s) { %>
                  <option value="<%= s %>" <%= o.paymentStatus === s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </form>
          </td>
          <td>
            <form action="/admin/orders/<%= o._id %>/status" method="POST" style="display:flex; gap: 0.4rem;">
              <select name="status" class="status-select" onchange="this.form.submit()">
                <% ['new','confirmed','shipped','completed','cancelled'].forEach(function(s) { %>
                  <option value="<%= s %>" <%= o.status === s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </form>
          </td>
          <td class="table-actions">
            <form action="/admin/orders/<%= o._id %>/delete" method="POST" onsubmit="return confirm('Xóa đơn hàng <%= o.orderCode %>?');">
              <button type="submit">Xóa</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
